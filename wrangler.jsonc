{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulseboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // API routes go to the Worker; everything else is the React app
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulseboard",
      // Placeholder for local dev. Replace with the id from `wrangler d1 create pulseboard` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every minute: check the monitors that are due
    "crons": ["* * * * *"]
  },
  "vars": {
    // Set to "true" only in local dev, so you can monitor http://localhost targets
    "ALLOW_PRIVATE_TARGETS": "false"
    // SIGNUP_EMAILS decides who may create an account. Unset = nobody, "*" = anyone,
    // or a comma-separated list of emails. Set it as a secret so real emails stay out of the repo:
    //   npx wrangler secret put SIGNUP_EMAILS
  },
  "observability": { "enabled": true }
}
